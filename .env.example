# Copy this file to .env in the same directory as docker-compose.yml.
# Docker Compose reads .env automatically. Do not commit .env.

# Host library folders, mounted at /music, /movies and /tv.
MUSIC_PATH=/your/music/share
MOVIES_PATH=/your/movies/share
TV_PATH=/your/tvshows/share

TZ=Europe/Oslo
PUID=1000
PGID=1000
APP_VERSION=1

# Web UI and webhook port.
CMM_PORT=4455
# Required for Radarr, Sonarr, Bazarr and Lidarr webhooks (X-Curator-Key header or ?apikey=). Webhooks are refused while empty.
CMM_API_KEY=
# Sliding debounce timer and the hard limit that forces a run during long download queues.
CMM_DEBOUNCE_MINUTES=20
CMM_MAX_POSTPONE_MINUTES=120
CMM_OVERWRITE_ALL=true
# Movie and TV files probed at the same time during a scan (1 to 8). Raise it for fast local disks.
CMM_PROBE_WORKERS=8
# Subtitle language codes: iso639-2 (eng) or iso639-1 (en). Can be changed on the Files settings tab.
CMM_SUBTITLE_LANG_STANDARD=iso639-2
# Remove subtitle sidecars whose text repeats another sidecar or an embedded stream (SHA-256). Off by default.
CMM_PURGE_DUPLICATE_SUBS=false
# Container path for movie set artwork and collection.nfo, for example /movies/_Sets. The folder must already exist inside the container. A value saved under Settings, Movie sets overrides this. Leave empty to skip set artwork.
CMM_SET_FOLDER=

# Optional HTTP basic auth, in the form user:password. Leave empty to disable.
BASIC_AUTH=

POSTGRES_USER=curator
POSTGRES_PASSWORD=curator
POSTGRES_DB=curator

# Optional metadata keys. A value saved in the Curator settings screen overrides these.
# Last.fm album lookup uses the API key. The shared secret is kept for signed requests.
LASTFM_API_KEY=
LASTFM_API_SECRET=
FANART_API_KEY=
ACOUSTID_API_KEY=
TMDB_API_KEY=
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=
# Optional. TV uses TMDB by default; TheTVDB v4 keys for personal use need a paid subscription.
TVDB_API_KEY=
OMDB_API_KEY=
# Trakt signs in with a device code at https://trakt.tv/activate. Curator calls Trakt,
# so the router does not need to forward a connection back to Curator.
# Paste the client ID from https://trakt.tv/oauth/applications. New apps have no client secret.
TRAKT_CLIENT_ID=

LIDARR_URL=
LIDARR_API_KEY=
RADARR_URL=
RADARR_API_KEY=
SONARR_URL=
SONARR_API_KEY=
# Unused today. Bazarr notifies Curator through the webhook above; Curator does not call Bazarr's API.
BAZARR_URL=
BAZARR_API_KEY=

# Kodi notifications (KODI_HOST) and library updates (KODI_LIBRARY_HOST) can use different Kodi instances.
# The library host falls back to KODI_HOST. Values saved under Settings > Notifications win.
KODI_HOST=
KODI_USERNAME=
KODI_PASSWORD=
KODI_LIBRARY_HOST=
KODI_LIBRARY_USERNAME=
KODI_LIBRARY_PASSWORD=

# Library refresh sent with Kodi when the webhook queue runs. Saved Integrations settings win.
JELLYFIN_URL=
JELLYFIN_API_KEY=
PLEX_URL=
PLEX_TOKEN=
EMBY_URL=
EMBY_API_KEY=
