# Default stack. Copy .env.example to .env and set MUSIC_PATH before the first start.
# Set MUSIC_PATH to the host library directory, for example W:/Music or /mnt/music.
services:
  postgres:
    image: postgres:16-alpine
    container_name: curator-postgres
    restart: unless-stopped
    environment:
      POSTGRES_USER: ${POSTGRES_USER:-curator}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-curator}
      POSTGRES_DB: ${POSTGRES_DB:-curator}
      TZ: ${TZ:-Europe/Oslo}
    # Log prefix only. Session timezone stays UTC so existing TIMESTAMP values keep the same clock.
    command: ["postgres", "-c", "log_timezone=${TZ:-}"]
    volumes:
      - curator-pg:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $$POSTGRES_USER -d $$POSTGRES_DB"]
      interval: 5s
      timeout: 5s
      retries: 20

  curator:
    build:
      context: ./app
      # Languages tesseract can read in picture subtitles (VobSub, PGS). Space separated
      # tesseract language codes; each adds a few MB to the image.
      # args:
      #   TESSERACT_LANGS: "eng nor swe dan fin deu fra spa ita nld por pol"
    container_name: curator
    image: curator
    restart: unless-stopped
    depends_on:
      postgres:
        condition: service_healthy
    ports:
      - "4455:4455"
    volumes:
      # Mount more libraries as extra container paths, then add those paths in Settings.
      # Example: - /mnt/flac:/music-flac
      - ${MUSIC_PATH:-/your/music/share}:/music
      - ${MOVIES_PATH:-/your/movies/share}:/movies
      - ${TV_PATH:-/your/tvshows/share}:/tv
      - ./config:/config
      # Files the app can rebuild: thumbnails, downloaded artwork, video previews. Safe to delete.
      - ./cache:/cache
      # Uploaded and replaced artwork. Cannot be rebuilt, so keep it in your backups. Can be purged in Settings.
      - ./data:/data
      - ${BACKUP_PATH:-./backups}:/backups
    environment:
      PYTHONUNBUFFERED: "1"
      TZ: ${TZ:-Europe/Oslo}
      PUID: ${PUID:-3000}
      PGID: ${PGID:-1000}
      BASIC_AUTH: ${BASIC_AUTH:-}
      APP_VERSION: ${APP_VERSION:-1}
      POSTGRES_HOST: postgres
      POSTGRES_PORT: "5432"
      POSTGRES_USER: ${POSTGRES_USER:-curator}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-curator}
      POSTGRES_DB: ${POSTGRES_DB:-curator}
      MUSIC_DIR: /music
      MOVIES_DIR: /movies
      TV_DIR: /tv
      CONFIG_DIR: /config
      CACHE_DIR: /cache
      DATA_DIR: /data
      BACKUP_DIR: /backups
      CMM_SET_FOLDER: ${CMM_SET_FOLDER:-}
      # Optional. A value saved in Settings overrides these. Last.fm lookup uses the API key.
      LASTFM_API_KEY: ${LASTFM_API_KEY:-}
      LASTFM_API_SECRET: ${LASTFM_API_SECRET:-}
      FANART_API_KEY: ${FANART_API_KEY:-}
      OMDB_API_KEY: ${OMDB_API_KEY:-}
      ACOUSTID_API_KEY: ${ACOUSTID_API_KEY:-}
      LIDARR_URL: ${LIDARR_URL:-}
      LIDARR_API_KEY: ${LIDARR_API_KEY:-}
      RADARR_URL: ${RADARR_URL:-}
      RADARR_API_KEY: ${RADARR_API_KEY:-}
      SONARR_URL: ${SONARR_URL:-}
      SONARR_API_KEY: ${SONARR_API_KEY:-}
      BAZARR_URL: ${BAZARR_URL:-}
      BAZARR_API_KEY: ${BAZARR_API_KEY:-}
      CMM_API_KEY: ${CMM_API_KEY:-}
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://127.0.0.1:$${CMM_PORT:-4455}/api/v1/health"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 25s

volumes:
  curator-pg:
